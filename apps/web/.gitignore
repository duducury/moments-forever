# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials; only .env.example is meant to be tracked
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor iOS — the Xcode project itself is committed; only local/generated
# build output is ignored (CocoaPods installs its own copy from the Podfile).
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
