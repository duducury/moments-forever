# Public site origin for Open Graph / WhatsApp link previews (no trailing slash).
# Example: https://moments-forever-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# Public Supabase configuration (safe to expose in clients).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend foundation.
PORT=4000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudflare R2 (private photo storage). Browser PUT uses presigned URLs —
# configure bucket CORS to allow PUT from your web origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moments-forever-photos
# Optional override (defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com)
R2_ENDPOINT=
MAPLIBRE_STYLE_URL=
