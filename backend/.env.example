PORT=4000
NODE_ENV=development

# Local Supabase only (Stage 1). Never point these at a remote project here.
# Example after `npx supabase start`:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<local anon key from `npx supabase status`>
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Reserved; not integrated in Stage 1.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
MAPLIBRE_STYLE_URL=
